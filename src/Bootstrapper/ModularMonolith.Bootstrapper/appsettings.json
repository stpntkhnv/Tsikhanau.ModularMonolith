{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ModularMonolith": {
    "Database": {
      "MaxConnections": 60
    },
    "Cleanup": {
      "Interval": "01:00:00",
      "KeepFor": "7.00:00:00"
    },
    "Queues": {
      "PollInterval": "00:00:05",
      "HandlerTimeout": "00:01:00"
    }
  }
}
