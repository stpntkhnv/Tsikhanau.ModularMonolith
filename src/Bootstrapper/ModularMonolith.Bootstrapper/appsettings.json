{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Migrations": "Information",
      "Npgsql": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "Database": {
      "MaxConnections": 20,
      "PrepareTimeout": "00:10:00"
    },
    "Cleanup": {
      "Interval": "01:00:00",
      "KeepFor": "7.00:00:00"
    },
    "Queues": {
      "PollInterval": "00:00:05",
      "HandlerTimeout": "00:01:00",
      "ClaimBatchSize": 16
    }
  }
}
