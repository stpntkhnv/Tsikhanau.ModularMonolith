<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>false</IsPackable>
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Tsikhanau.Monolith.Analyzers' and '$(MSBuildProjectName)' != 'Tsikhanau.Monolith.Analyzers.Tests'">
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)Analyzers/Tsikhanau.Monolith.Analyzers.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      IsAspireProjectResource="false" />
    <CoreAnalyzer Include="Tsikhanau.Monolith.Analyzers" />
  </ItemGroup>
  <ItemGroup Condition="!$(MSBuildProjectName.EndsWith('Tests')) and '$(MSBuildProjectName)' != 'Tsikhanau.Monolith.Testing' and '$(MSBuildProjectName)' != 'Tsikhanau.Monolith.ArchRules' and !$(MSBuildProjectName.EndsWith('.Testing.App')) and '$(MSBuildProjectName)' != 'Tsikhanau.Monolith.Analyzers'">
    <ProjectReference
      Include="$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)../Packages/Tsikhanau.Railway.Analyzers/Tsikhanau.Railway.Analyzers.csproj'))"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      IsAspireProjectResource="false" />
    <CoreAnalyzer Include="Tsikhanau.Railway.Analyzers" />
  </ItemGroup>
  <ItemGroup Condition="!$(MSBuildProjectName.EndsWith('Tests')) and '$(MSBuildProjectName)' != 'Tsikhanau.Monolith.Testing' and '$(MSBuildProjectName)' != 'Tsikhanau.Monolith.ArchRules' and !$(MSBuildProjectName.EndsWith('.Testing.App')) and '$(MSBuildProjectName)' != 'Tsikhanau.Monolith.Perf'">
    <AdditionalFiles Include="$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)../../BannedSymbols.txt'))" />
    <CoreAdditionalFiles Include="$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)../../BannedSymbols.txt'))" />
  </ItemGroup>
  <PropertyGroup>
    <CoreBuildPropsImported>true</CoreBuildPropsImported>
    <CoreNoWarn>CS1591</CoreNoWarn>
  </PropertyGroup>
  <Target
    Name="CheckCoreBuildTargetsImported"
    BeforeTargets="CoreCompile"
    Condition="'$(CoreBuildTargetsImported)' != 'true'">
    <Error
      Text="$(MSBuildProjectName): the build does not import src/Core/Core.Build.targets, which checks the core's build settings; a Directory.Build.targets nearer to the project, ImportDirectoryBuildTargets or DirectoryBuildTargetsPath hides the root one (set by the core; change it in the template)" />
  </Target>
</Project>
