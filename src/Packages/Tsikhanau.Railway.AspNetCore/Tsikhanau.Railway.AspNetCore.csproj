<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>Tsikhanau.Railway.AspNetCore</PackageId>
        <Description>ASP.NET Core integration for Tsikhanau.Railway: turn Result and Error into HTTP results with ProblemDetails</Description>
        <IsPackable>true</IsPackable>
        <IsAotCompatible>true</IsAotCompatible>
        <PackageTags>railway-oriented;result;error-handling;aspnetcore;problem-details;minimal-api;csharp;dotnet</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Tsikhanau.Railway\Tsikhanau.Railway.csproj" PrivateAssets="none" />
        <ProjectReference Include="..\Tsikhanau.Railway.Analyzers\Tsikhanau.Railway.Analyzers.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" />
    </ItemGroup>

</Project>
