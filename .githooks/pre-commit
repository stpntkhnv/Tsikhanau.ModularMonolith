#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

dotnet build ModularMonolith.slnx

for project in \
  template-only/Analyzers.Tests \
  template-only/Shared.Tests \
  template-only/UnitTests \
  src/Tests/ArchTests; do
  dotnet test --project "$project" --no-build
done
