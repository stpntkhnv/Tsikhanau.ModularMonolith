root = true

[*.cs]
dotnet_style_predefined_type_for_locals_parameters_members = false
dotnet_style_predefined_type_for_member_access = false
dotnet_diagnostic.IDE0005.severity = error
dotnet_diagnostic.IDE0049.severity = error
dotnet_diagnostic.RCS0056.severity = error
roslynator_max_line_length = 120
dotnet_code_quality.CA1852.ignore_internalsvisibleto = true
dotnet_diagnostic.RS0030.severity = error
dotnet_diagnostic.CA1031.severity = error
dotnet_diagnostic.CA1849.severity = error
dotnet_diagnostic.CA1852.severity = error
dotnet_diagnostic.CA2012.severity = error
dotnet_diagnostic.CA2016.severity = error
dotnet_diagnostic.CA2100.severity = error
dotnet_diagnostic.VSTHRD002.severity = error
dotnet_diagnostic.VSTHRD100.severity = error
dotnet_diagnostic.VSTHRD103.severity = error
dotnet_diagnostic.VSTHRD110.severity = error
dotnet_diagnostic.VSTHRD003.severity = none
dotnet_diagnostic.VSTHRD111.severity = none
dotnet_diagnostic.VSTHRD200.severity = none

[**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.IDE0049.severity = none
dotnet_diagnostic.RCS0056.severity = none

[template-only/TestModules/{Pings/Features/ThrowAfterTouch/ThrowAfterTouchCommandHandler.cs,Pongs/Features/PingCreated/PingCreatedIntegrationEventHandler.cs}]
dotnet_diagnostic.TS0005.severity = none

[src/Core/Infrastructure/Platform/PlatformServiceCollectionExtensions.cs]
dotnet_diagnostic.RS0030.severity = none

[src/Core/Infrastructure/{Queues/ModuleQueueProcessor.cs,Cleanup/ModuleCleanupProcessor.cs}]
dotnet_diagnostic.CA1031.severity = none

[{src/Core/Testing/**.cs,src/Core/ArchRules/**.cs,src/Tests/**.cs,template-only/IntegrationTests/**.cs,template-only/UnitTests/**.cs,template-only/Analyzers.Tests/**.cs,template-only/Shared.Tests/**.cs,template-only/ArchRules.Tests/**.cs,template-only/Scaffold.Tests/**.cs}]
dotnet_diagnostic.CA1031.severity = none
dotnet_diagnostic.CA2100.severity = none
dotnet_diagnostic.CA1849.severity = none
dotnet_diagnostic.VSTHRD002.severity = none
dotnet_diagnostic.VSTHRD103.severity = none
dotnet_diagnostic.TS0005.severity = none
dotnet_diagnostic.TS0006.severity = none

[{src/Core/**.cs,template-only/perf/**.cs}]
dotnet_diagnostic.TS0006.severity = none
