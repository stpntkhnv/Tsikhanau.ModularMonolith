+using ModularMonolith.Modules.Notes.Contracts.IntegrationEvents;
+using ModularMonolith.Modules.Notes.Domain.Notes.Events;
+using Tsikhanau.Monolith.Application.Events;
+using Tsikhanau.Railway;
+
+namespace ModularMonolith.Modules.Notes.Features.NoteCreated;
+
+internal sealed class NoteCreatedDomainEventHandler(IOutbox<INotesModule> outbox)
+    : IDomainEventHandler<NoteCreatedDomainEvent>
+{
+    public Task<Result<Unit>> Handle(NoteCreatedDomainEvent domainEvent, CancellationToken cancellationToken)
+    {
+        outbox.Add(
+            new NoteCreatedIntegrationEvent(
+                domainEvent.OccurredOn,
+                domainEvent.NoteId.Value,
+                domainEvent.Title.Value));
+
+        return Task.FromResult(Result.Success());
+    }
+}
