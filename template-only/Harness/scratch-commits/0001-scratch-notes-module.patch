diff --git a/src/Modules/Notes/ModularMonolith.Modules.Notes/Features/CreateNote/CreateNoteCommandHandler.cs b/src/Modules/Notes/ModularMonolith.Modules.Notes/Features/CreateNote/CreateNoteCommandHandler.cs
