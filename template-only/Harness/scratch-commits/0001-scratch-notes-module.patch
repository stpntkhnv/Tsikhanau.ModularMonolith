+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Routing;
+using Tsikhanau.Monolith.Api.Endpoints;
+using Tsikhanau.Railway;
+
+namespace ModularMonolith.Modules.Notes.Features.CreateNote;
+
+internal sealed class CreateNoteEndpoint : IEndpoint
+{
+    public void Map(IEndpointRouteBuilder endpoints) => endpoints.MapPost("/", CreateAsync);
+
+    private static Task<IResult> CreateAsync(
+        CreateNoteRequest request,
+        INotesModule notesModule,
+        CancellationToken cancellationToken) =>
+        notesModule
+            .ExecuteCommandAsync(new CreateNoteCommand(request.NoteId, request.Title), cancellationToken)
+            .ToHttpResultAsync();
+
+    internal sealed record CreateNoteRequest(Guid NoteId, String Title);
+}
