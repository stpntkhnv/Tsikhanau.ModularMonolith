@@ -0,0 +1,21 @@
+using ModularMonolith.Modules.Notes.Domain.Notes;
+using Tsikhanau.Railway;
+
+namespace ModularMonolith.Modules.Notes.Infrastructure.Persistence;
+
+internal sealed class NoteRepository(NotesDbContext notesDbContext) : INoteRepository
+{
+    public void Add(Note note) =>
+        notesDbContext
+            .Set<Note>()
+            .Add(note);
+
+    public async Task<Result<Note>> GetAsync(NoteId noteId, CancellationToken cancellationToken)
+    {
+        Optional<Note> foundNote = await notesDbContext
+            .Set<Note>()
+            .FindAsync([noteId], cancellationToken);
+
+        return foundNote.ToResult(NoteErrors.NotFound);
+    }
+}
