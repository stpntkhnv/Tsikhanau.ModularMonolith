@@ -0,0 +1,26 @@
+using Dapper;
+using ModularMonolith.Modules.Notes.Contracts.Queries.GetNote;
+using ModularMonolith.Modules.Notes.Domain.Notes;
+using Tsikhanau.Monolith.Application.Queries;
+using Tsikhanau.Railway;
+
+namespace ModularMonolith.Modules.Notes.Features.GetNote;
+
+internal sealed class GetNoteQueryHandler(ISqlConnectionFactory<INotesModule> sqlConnectionFactory)
+    : IQueryHandler<GetNoteQuery, NoteDto>
+{
+    private const String Sql = """
+        SELECT id AS "Id", title AS "Title"
+        FROM notes.notes
+        WHERE id = @NoteId
+        """;
+
+    public async Task<Result<NoteDto>> Handle(GetNoteQuery query, CancellationToken cancellationToken)
+    {
+        await using var connection = await sqlConnectionFactory.OpenConnectionAsync(cancellationToken);
+        Optional<NoteDto> foundNote = await connection.QuerySingleOrDefaultAsync<NoteDto>(
+            new CommandDefinition(Sql, new { query.NoteId }, cancellationToken: cancellationToken));
+
+        return foundNote.ToResult(NoteErrors.NotFound);
+    }
+}
diff --git a/src/Modules/Notes/ModularMonolith.Modules.Notes/Features/NoteCreated/NoteCreatedDomainEventHandler.cs b/src/Modules/Notes/ModularMonolith.Modules.Notes/Features/NoteCreated/NoteCreatedDomainEventHandler.cs
