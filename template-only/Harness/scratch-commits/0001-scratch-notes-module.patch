+using ModularMonolith.Modules.Notes.Domain.Notes.Events;
+using Tsikhanau.Monolith.Domain.Aggregates;
+
+namespace ModularMonolith.Modules.Notes.Domain.Notes;
+
+internal sealed class Note : AggregateRoot<NoteId>
+{
+    private Note(NoteId id) : base(id) { }
+
+    public NoteTitle Title { get; private set; }
+
+    public static Note Create(NoteId id, NoteTitle title, DateTimeOffset createdOn)
+    {
+        var note = new Note(id) { Title = title };
+        note.Raise(new NoteCreatedDomainEvent(createdOn, id, title));
+        return note;
+    }
+}
