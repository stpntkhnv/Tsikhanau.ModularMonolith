diff --git a/src/Modules/Notes/ModularMonolith.Modules.Notes/Features/GetNote/GetNoteQueryHandler.cs b/src/Modules/Notes/ModularMonolith.Modules.Notes/Features/GetNote/GetNoteQueryHandler.cs
