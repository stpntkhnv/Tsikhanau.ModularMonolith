+using System.Net;
+using System.Net.Http.Json;
+using Microsoft.Extensions.DependencyInjection;
+using ModularMonolith.Modules.Notes;
+using ModularMonolith.Modules.Notes.Contracts.Queries.GetNote;
+using ModularMonolith.Modules.Notes.Features.CreateNote;
+using ModularMonolith.Testing.App;
+
+namespace ModularMonolith.IntegrationTests.Modules.Notes;
+
+public sealed class NotesTests(AppFixture appFixture) : AppTest(appFixture)
+{
+    private static CancellationToken CancellationToken => TestContext.Current.CancellationToken;
+
+    [Fact]
+    public async Task Created_note_is_read_back_through_the_facade()
+    {
+        var notesModule = App.Services.GetRequiredService<INotesModule>();
+        var noteId = Guid.CreateVersion7();
+
+        var created = await notesModule.ExecuteCommandAsync(new CreateNoteCommand(noteId, "first"), CancellationToken);
+        var note = await notesModule.ExecuteQueryAsync(new GetNoteQuery(noteId), CancellationToken);
+
+        created.IsSuccess.ShouldBeTrue();
+        note.Value.ShouldBe(new NoteDto(noteId, "first"));
+    }
+
+    [Fact]
+    public async Task Created_note_is_processed_end_to_end()
+    {
+        var notesModule = App.Services.GetRequiredService<INotesModule>();
+        var noteId = Guid.CreateVersion7();
+        var created = await notesModule.ExecuteCommandAsync(new CreateNoteCommand(noteId, "second"), CancellationToken);
+
+        await App.ProcessQueuesAsync();
+
+        created.IsSuccess.ShouldBeTrue();
+    }
+
+    [Fact]
+    public async Task Created_note_reaches_tags()
+    {
+        var notesModule = App.Services.GetRequiredService<INotesModule>();
+        var noteId = Guid.CreateVersion7();
+        await notesModule.ExecuteCommandAsync(new CreateNoteCommand(noteId, "third"), CancellationToken);
+
+        await App.ProcessQueuesAsync();
+        var inboxRows = await App.Database.ReadQueueRowsAsync("tags", "inbox_messages");
+
+        inboxRows
+            .ShouldHaveSingleItem().IsProcessed
+            .ShouldBeTrue();
+    }
+
+    [Fact]
+    public async Task Note_is_created_over_http()
+    {
+        using var httpClient = App.CreateClient();
+        var noteId = Guid.CreateVersion7();
+
+        var createResponse = await httpClient.PostAsJsonAsync(
+            "/notes",
+            new { noteId, title = "fourth" },
+            CancellationToken);
+
+        var getResponse = await httpClient.GetAsync($"/notes/{noteId}", CancellationToken);
+
+        createResponse.StatusCode.ShouldBe(HttpStatusCode.OK);
+        getResponse.StatusCode.ShouldBe(HttpStatusCode.OK);
+    }
+}
